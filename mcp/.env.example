# Copy to mcp/.env. Never commit real values.
MCP_PORT=3001
MCP_BACKEND_URL=http://127.0.0.1:5000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,parent-displayed-sen-calm.trycloudflare.com
# For a Cloudflare Tunnel, set this to its permanent HTTPS origin (no trailing slash).
MCP_PUBLIC_URL=
# ChatGPT predefined OAuth client ID and exact callback URL from its connection setup.
MCP_OAUTH_CLIENT_ID=alzhen-chatgpt
# This stable callback works when ChatGPT uses issuer identification; use the exact URL shown in your connection setup if different.
MCP_OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
# Supabase publishable/anon key and URL, used only to renew this user's login token.
# Never use a service_role or secret key here.
MCP_SUPABASE_URL=
MCP_SUPABASE_ANON_KEY=
MCP_MAX_PAGE_SIZE=20
MCP_MAX_DETAIL_ITEMS=50
