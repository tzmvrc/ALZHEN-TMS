# Copy to deployment/secrets/backend.env (ignored), chmod 600. Never build into an image.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-locally-with-private-service-role-key
MAPBOX_DIRECTIONS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Do not configure paid provider calls until separately approved.
# Single backend only. Multiple replicas need the existing shared Redis adapter.
SOCKET_REDIS_URL=
