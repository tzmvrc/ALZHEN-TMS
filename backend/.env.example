API_BASE_URL=http://localhost:5000
# Server-side delivery geocoding. No VITE_ key; never expose this to the browser.
# Geoapify supports permanent result storage and the existing Mapbox display.
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
# Limits apply per backend process. Also configure provider account quotas.
GEOCODING_DAILY_LIMIT=1000
GEOCODING_MIN_INTERVAL_MS=600
# Alternative: GEOCODING_PROVIDER=nominatim with your own hosted endpoint.
# Public nominatim.openstreetmap.org is not used for automated trip lookups.
NOMINATIM_SEARCH_URL=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_TRUCKER_EMAIL=
TEST_TRUCKER_PASSWORD=

# Socket.IO: comma-separated browser origins, exact protocol/host/port.
SOCKET_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for multiple backend replicas; keep the Redis URL server-side.
WEB_CONCURRENCY=1
SOCKET_REDIS_URL=

# Private backend-only POD interpretation. Never use VITE_ prefixes for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Keep disabled until 2026_10_31_proposed_pod_review.sql is approved/applied.
POD_REVIEW_ENABLED=false

# Prepared backend Directions adapter; never falls back to a frontend token.
# Leave empty until routing activation, cost limits and persistence are approved.
MAPBOX_DIRECTIONS_TOKEN=
TRACKING_ENABLED=false
# Separate from GPS. Keep false until planned-cache migration/provider approval.
PLANNED_ROUTES_ENABLED=false
# Optional controlled local acceptance: set BOTH exact UUIDs, or leave BOTH empty.
# Does not enable tracking. Never expose these restrictions as frontend controls.
TRACKING_TEST_PROFILE_ID=
TRACKING_TEST_ASSIGNMENT_ID=
# Only after PDF Storage/metadata migration approval and renderer verification.
POD_PDF_ENABLED=false

# Production requires exact HTTPS browser origins and the isolated Linux worker.
# Development omits the socket and keeps PDF intake off by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
PDF_WORKER_SOCKET=

# Operational report email. Backend only; never use VITE_ prefixes for credentials.
# Omitted EMAIL_PROVIDER defaults to resend for compatibility. Restart after changes.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="ALZHEN TMS <onboarding@resend.dev>"
RESEND_EMAIL_ENABLED=false

# Temporary Gmail provider: select EMAIL_PROVIDER=gmail to use these values.
# Gmail requires SSL/TLS on port 465; normal Google account passwords are unsupported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME="ALZHEN TMS"

# Automatic Trucker POD reading. Backend only; never add VITE_ credentials.
# Uses the existing Tesseract.js provider, now also declared in backend dependencies.
POD_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Exact non-Flash model ID available to this account; runtime checks /models first.
DEEPSEEK_MODEL=

# Optional offline English language data and writable Tesseract cache directory.
# TESSERACT_LANG_PATH=
# TESSERACT_CACHE_PATH=

# New-device security emails (existing SMTP_APP_PASSWORD is also supported)
SECURITY_LOGIN_EMAIL_ENABLED=true
SMTP_PASSWORD=
SMTP_FROM=
# Optional trusted HTTPS endpoint returning {city,country}; IP sent as ip query parameter
LOGIN_GEOLOCATION_URL=
LOGIN_GEOLOCATION_TOKEN=
